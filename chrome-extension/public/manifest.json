{
  "manifest_version": 3,
  "name": "Lead Intelligence",
  "version": "0.1.0",
  "description": "Discover and analyze European Software / IT companies from Chrome's side panel.",
  "permissions": ["sidePanel", "storage"],
  "action": {
    "default_title": "Open Lead Intelligence",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": []
}
